# Copy to .env.local and fill in. Never commit .env.local.

# ---- Database (MongoDB) ----
# https://cloud.mongodb.com -> your cluster -> Connect -> Drivers
# The database name goes in the path, e.g. .../hueglam?retryWrites=true
MONGODB_URI="mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/hueglam?retryWrites=true&w=majority"

# ---- Admin panel ----
# Used by `npm run db:seed` to create or reset the admin login.
# The seed refuses anything shorter than 12 characters: this is the only
# credential standing between the internet and your order data.
ADMIN_EMAIL="you@hueglam.com"
ADMIN_PASSWORD="change-this-to-something-long"

# Signs both the admin and the customer session cookies. Required — sign-in is
# disabled without it. Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out, which is how you revoke every session at once.
AUTH_SECRET=""

# ---- Payments (Razorpay) ----
# https://dashboard.razorpay.com -> Settings -> API Keys
# Use the rzp_test_ keys until you are ready to take real money.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"

# ---- Transactional email (Resend) ----
# https://resend.com -> API Keys. Leave RESEND_API_KEY empty to skip sending;
# orders still complete, they just go unconfirmed by email.
RESEND_API_KEY=""
ORDER_EMAIL_FROM="HUEGLAM <orders@hueglam.com>"
ORDER_EMAIL_BCC="support@hueglam.com"

# ---- Store ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Free shipping at or above this subtotal, in paise. 99900 = Rs. 999
FREE_SHIPPING_THRESHOLD="99900"
# Flat shipping charge below the threshold, in paise. 4900 = Rs. 49
SHIPPING_FLAT_RATE="4900"
