# ---- Database (Neon Postgres) ----
# https://console.neon.tech -> create project -> copy the pooled connection string
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ---- Admin panel ----
# Used once by `npm run db:seed` to create/reset the admin login.
ADMIN_EMAIL="you@hueglam.com"
ADMIN_PASSWORD="change-this-to-something-long"
# Signing secret for the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# ---- Payments (Razorpay) ----
# https://dashboard.razorpay.com -> Settings -> API Keys
# Use the rzp_test_ keys until you are ready to take real money.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"

# ---- Transactional email (Resend) ----
# https://resend.com -> API Keys. Leave RESEND_API_KEY empty to skip sending.
RESEND_API_KEY=""
ORDER_EMAIL_FROM="HUEGLAM <orders@hueglam.com>"
ORDER_EMAIL_BCC="support@hueglam.com"

# ---- Store ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Free shipping at or above this subtotal, in paise. 99900 = Rs. 999
FREE_SHIPPING_THRESHOLD="99900"
# Flat shipping charge below the threshold, in paise. 4900 = Rs. 49
SHIPPING_FLAT_RATE="4900"

# ---- Instagram feed (optional) ----
# Homepage rail. Without this the curated fallback images are used.
# Instagram Graph API long-lived token: https://developers.facebook.com/docs/instagram-basic-display-api
# Keep this server-side only. Never expose it in client HTML.
INSTAGRAM_ACCESS_TOKEN=""
